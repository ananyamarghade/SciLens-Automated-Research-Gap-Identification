# ==============================================================================
# SciLens Environment Configuration
# ==============================================================================

# LLM Providers (OpenAI, Gemini, Groq, or Ollama)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Scientific Literature Retrieval Providers
# OpenAlex: Broad discovery across 250M+ scientific publications (No key required for modest usage, optional API key for high speed)
OPENALEX_API_KEY=

# CORE: Open-access repository search and full-text retrieval (core.ac.uk)
# Optional: Free API key from https://core.ac.uk/services/api/ increases rate limit and enables direct fullText payloads.
# Public queries and open-access PDF downloads work out-of-the-box even without a key.
CORE_API_KEY=

# arXiv: AI/ML/CS preprints and recent empirical advances (No key required, rate limit delay in seconds)
ARXIV_RATE_LIMIT_DELAY=3.0

# Optional Web Search
TAVILY_API_KEY=

# Application & Database
DATABASE_URL=sqlite:///./scilens.db
APP_ENV=development
